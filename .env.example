NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME?sslmode=disable

# Dedicated database for tests. Its name MUST end in "_test"; the test run aborts otherwise.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME_test?sslmode=disable
LOG_LEVEL=info

# Storage driver: "local" (default in development/test) or "s3" (required in production).
STORAGE_DRIVER=local

# Local driver: files on disk. The secret signs download URLs (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_STORAGE_DIR=./.data/storage
LOCAL_STORAGE_SIGNING_SECRET=
# Optional; defaults to http://localhost:PORT. Also the only Origin accepted on state-changing
# requests (CSRF check), so set it to the public address of the panel.
PUBLIC_BASE_URL=

# S3 driver: any S3-compatible service. Endpoint is only needed for non-AWS services.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Language model: LLM_PROVIDER is "fake" (default in development and test) or "claude" (must be set
# explicitly in production). With "claude", LLM_MODEL and NOVACIEL_ANTHROPIC_API_KEY are required;
# with "fake", LLM_MODEL defaults to fake-model. LLM_TIMEOUT_MS is the request timeout (default 60000).
# The key variable is deliberately NOT ANTHROPIC_API_KEY: Claude Code reads that one for its own
# login, and the two must never mix. Enter the key by hand in .env, never in code or commits.
LLM_PROVIDER=
LLM_MODEL=
LLM_TIMEOUT_MS=
NOVACIEL_ANTHROPIC_API_KEY=

# Encryption keys for stored credentials (AES-256-GCM). Required in every environment.
# Comma-separated list of version:base64key; each key must decode to exactly 32 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Example shape: SECRETS_KEYS=1:<base64>,2:<base64>
SECRETS_KEYS=
# Version used to encrypt new values; it must be present in SECRETS_KEYS.
# Keep old versions in the list so existing values stay readable after rotation.
SECRETS_ACTIVE_KEY_VERSION=

# scrypt cost for password hashing, as log2(N). Default 15; values below 15 are rejected outside NODE_ENV=test.
PASSWORD_SCRYPT_LOG_N=

# Sessions: absolute lifetime in hours (default 12) and idle timeout in minutes (default 120).
# The idle check can be up to 60 seconds looser than configured.
SESSION_TTL_HOURS=
SESSION_IDLE_MINUTES=

# There is no variable for passwords. The first administrator is created with:
#   npm run create-admin -- --email <email>
# which asks for the password at a hidden prompt (or reads it from stdin). It is never read from
# arguments or the environment.
