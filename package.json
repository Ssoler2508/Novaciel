{
  "name": "novaciel-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.remotion.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"**/*.render.test.ts\"",
    "seed": "tsx src/scripts/seed.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "set-price": "tsx src/scripts/setPrice.ts",
    "llm:smoke": "tsx src/scripts/llmSmoke.ts",
    "media:upload": "tsx src/scripts/mediaUpload.ts",
    "plan:generate": "tsx src/scripts/planGenerate.ts",
    "brief:generate": "tsx src/scripts/briefGenerate.ts",
    "piece:produce": "tsx src/scripts/pieceProduce.ts",
    "qc:run": "tsx src/scripts/qcRun.ts",
    "remotion:browser": "tsx src/scripts/remotionBrowser.ts",
    "plan:approve": "tsx src/scripts/planApprove.ts",
    "piece:approve": "tsx src/scripts/pieceApprove.ts",
    "piece:reopen": "tsx src/scripts/pieceReopen.ts",
    "piece:publicable": "tsx src/scripts/piecePublicable.ts",
    "password:set-dev": "tsx src/scripts/passwordSetDev.ts",
    "migrate:up": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m src/db/migrations",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m src/db/migrations"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@napi-rs/canvas": "1.0.11",
    "@remotion/bundler": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "dotenv": "^18.0.6",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
